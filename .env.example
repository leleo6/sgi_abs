# =====================================================================
# SGI-ABS — Configuración de Entorno para Docker Compose
# =====================================================================

# Puertos expuestos en el host local
# (Configurados por defecto en 8085, 3308 y 8086 para evitar conflictos)
APP_PORT=8085
DB_PORT_EXTERNAL=3308
PMA_PORT=8086

# Configuración de Base de Datos MySQL
DB_NAME=sgi_abs
DB_USER=root
DB_PASSWORD=root_password
DB_ROOT_PASSWORD=root_password
